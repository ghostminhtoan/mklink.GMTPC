<Window x:Class="MKLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MKLink.ViewModels"
        mc:Ignorable="d"
        Title="MKLink Path Mapper"
        Height="820"
        Width="1180"
        MinHeight="680"
        MinWidth="720"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/MainWindowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <DataTemplate x:Key="InputPanelTemplate">
            <Border Margin="0,6,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="INPUT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding SourceItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="{Binding CanEditRows}"
                              IsReadOnly="{Binding IsMirrorTab}"
                              SelectionChanged="InputGrid_SelectionChanged"
                              CanUserSortColumns="True"
                              Sorting="InputGrid_Sorting">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DarkDataGridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Input"
                                                Width="*"
                                                Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}"
                                                EditingElementStyle="{StaticResource WrapTextBoxStyle}" />
                            <DataGridTextColumn Header="Normalize Input"
                                                Width="*"
                                                IsReadOnly="True"
                                                Binding="{Binding NormalizedInput, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutputPanelTemplate">
            <Border Margin="0,6,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="OUTPUT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding SourceItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionChanged="InputGrid_SelectionChanged"
                              Loaded="EditOutputGrid_Loaded"
                              LoadingRow="OutputGrid_LoadingRow"
                              Sorting="OutputGrid_Sorting"
                              PreviewKeyDown="OutputGrid_PreviewKeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DarkDataGridRowStyle}">
                                <EventSetter Event="MouseDoubleClick" Handler="OutputGridRow_MouseDoubleClick" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Output"
                                                Width="*"
                                                CanUserSort="False"
                                                Binding="{Binding MappedTarget, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}" />
                            <DataGridTextColumn Header="Edit Output"
                                                Width="*"
                                                CanUserSort="True"
                                                Binding="{Binding EffectiveOutputPath, Mode=OneWay}"
                                                ElementStyle="{StaticResource EditedTextBlockStyle}" />
                            <DataGridTemplateColumn Header="Filter"
                                                    Width="90"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Button Content="Filter"
                                                Padding="4,0"
                                                MinWidth="70"
                                                Click="EditOutputFilterHeaderButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EditOutputStateText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResultPanelTemplate">
            <Border Margin="0,6,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                    <WrapPanel Grid.Row="2"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right">
                        <Button Content="Copy"
                                Width="88"
                                Click="CopyResultButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Background" Value="#4C8BFF" />
                                    <Setter Property="BorderBrush" Value="#4C8BFF" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#6AA2FF" />
                                            <Setter Property="BorderBrush" Value="#6AA2FF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#3B75D9" />
                                            <Setter Property="BorderBrush" Value="#3B75D9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Copy, delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="CopyAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Background" Value="#C97728" />
                                    <Setter Property="BorderBrush" Value="#C97728" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E08A38" />
                                            <Setter Property="BorderBrush" Value="#E08A38" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#AA5F1F" />
                                            <Setter Property="BorderBrush" Value="#AA5F1F" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="DeleteAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Background" Value="#B33A3A" />
                                    <Setter Property="BorderBrush" Value="#B33A3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D04949" />
                                            <Setter Property="BorderBrush" Value="#D04949" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#9E3030" />
                                            <Setter Property="BorderBrush" Value="#9E3030" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReverseResultPanelTemplate">
            <Border Margin="0,6,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                    <WrapPanel Grid.Row="2"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right">
                        <Button Click="ReversePrimaryActionButton_Click"
                                Width="140">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="#B33A3A" />
                                    <Setter Property="BorderBrush" Value="#B33A3A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseDelete}">
                                            <Setter Property="Content" Value="Delete reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="#B33A3A" />
                                            <Setter Property="BorderBrush" Value="#B33A3A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Background" Value="#4C8BFF" />
                                            <Setter Property="BorderBrush" Value="#4C8BFF" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D04949" />
                                            <Setter Property="BorderBrush" Value="#D04949" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#9E3030" />
                                            <Setter Property="BorderBrush" Value="#9E3030" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="ReverseSecondaryActionButton_Click"
                                Width="160"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete and copy reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="#7C5CFF" />
                                    <Setter Property="BorderBrush" Value="#7C5CFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Delete and copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#9278FF" />
                                            <Setter Property="BorderBrush" Value="#9278FF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#6850D9" />
                                            <Setter Property="BorderBrush" Value="#6850D9" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                                                </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" x:Name="MainLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Style="{StaticResource PanelBorderStyle}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="MKLink Path Mapper"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Cleaner shell, tighter spacing, and responsive controls for both landscape and portrait." />
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="8">
            <Grid x:Name="MainShellGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MainContentColumn" Width="*" />
                    <ColumnDefinition x:Name="SidebarLayoutColumn" Width="150" />
                </Grid.ColumnDefinitions>

                <TabControl x:Name="MainTabControl"
                            Grid.Column="0"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem x:Name="DirectTabItem"
                             Header="Direct">
                <Grid Margin="0,6,0,0">
                    <TabControl x:Name="DirectChildTabControl"
                                ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem x:Name="DirectCopyTabItem" Header="COPY" DataContext="{Binding CopyTab}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}"
                                        Padding="10,6">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Browse Root Folder"
                                                IsEnabled="{Binding CanEditRows}"
                                                Click="BrowseRootFolderButton_Click"
                                                Margin="0,4,12,4" />
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                            <TextBlock Text="Subfolder Name"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Width="180"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="{Binding IsMirrorTab}"
                                                     Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="Apply Target"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding ApplyTargetCommand}" />
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Vertical"
                                                    Margin="12,4,0,4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding RootTargetPath, StringFormat=Target root: {0}}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Each source path will create its own subfolder under this target." />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: INPUT panel -->
                                    <Border Grid.Row="0"
                                            Margin="0,6,0,0"
                                            Style="{StaticResource PanelBorderStyle}">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="INPUT"
                                                       Style="{StaticResource PanelTitleTextStyle}" />
                                            <DataGrid x:Name="CopyInputGrid"
                                                      Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding SourceItems}"
                                                      AutoGenerateColumns="False"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      AllowDrop="True"
                                                      SelectionChanged="InputGrid_SelectionChanged"
                                                      PreviewMouseLeftButtonDown="CopyInputGrid_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="CopyInputGrid_PreviewMouseMove"
                                                      DragOver="CopyInputGrid_DragOver"
                                                      Drop="CopyInputGrid_Drop"
                                                      PreviewKeyDown="CopyInputGrid_PreviewKeyDown"
                                                      CanUserSortColumns="True"
                                                      Sorting="InputGrid_Sorting">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow"
                                                           BasedOn="{StaticResource DarkDataGridRowStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Input"
                                                                        Width="*"
                                                                        Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        ElementStyle="{StaticResource WrapTextBlockStyle}"
                                                                        EditingElementStyle="{StaticResource WrapTextBoxStyle}" />
                                                    <DataGridTextColumn Header="Normalize Input"
                                                                        Width="*"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding NormalizedInput, Mode=OneWay}"
                                                                        ElementStyle="{StaticResource WrapTextBlockStyle}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Row 1: OUTPUT panel -->
                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="DirectDeleteTabItem" Header="DELETE" DataContext="{Binding DeleteTab}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="DELETE phụ thuộc Tab COPY: chỉ lấy input Copy và không có output." />
                                </Border>

                                <ContentControl Grid.Row="1"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource InputPanelTemplate}" />
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="DirectMklinkTabItem" Header="MKLINK D" DataContext="{Binding MklinkTab}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="MKLINK D phụ thuộc Tab COPY: input và output mirror y chang Copy." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                    </TabItem>

                    <TabItem x:Name="CheckMklinkTab"
                             Header="Check mklink">
                    </TabItem>

                    <TabItem x:Name="ResultTabItem"
                             Header="Result">
                <Grid Margin="0,6,0,0">
                    <TabControl x:Name="ResultChildTabControl"
                                ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem x:Name="ResultDirectSectionTabItem" Header="Direct">
                            <Grid Margin="0,6,0,0">
                                <TabControl x:Name="ResultDirectChildTabControl"
                                            ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                                    <TabItem x:Name="ResultCopyDirectTabItem" Header="Result copy direct">
                                        <ContentControl Content="{Binding CopyTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem x:Name="ResultDeleteDirectTabItem" Header="Result delete direct">
                                        <ContentControl Content="{Binding DeleteTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem x:Name="ResultMklinkDirectTabItem" Header="Result mklink D direct">
                                        <ContentControl Content="{Binding MklinkTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem x:Name="ResultCombinedDirectTabItem" Header="Result copy delete and mklink direct">
                                        <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="RESULT" Style="{StaticResource PanelTitleTextStyle}" />
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBox IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Style="{StaticResource ResultTextBoxStyle}"
                                                             Text="{Binding CombinedCopyDeleteMklinkScript, Mode=OneWay}" />
                                                </Grid>
                    <WrapPanel Grid.Row="2"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right">
                                                    <Button Content="Copy"
                                                            Width="88"
                                                            Click="CopyCombinedDirectScriptButton_Click" />
                                                    <Button Content="Copy, delete and mklink"
                                                            Width="140"
                                                            Margin="8,0,0,0"
                                                            Click="CopyAndMklinkButton_Click" />
                                                    <Button Content="Delete and mklink"
                                                            Width="140"
                                                            Margin="8,0,0,0"
                                                            Click="DeleteAndMklinkButton_Click" />
                    </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="ResultReverseSectionTabItem" Header="Reverse">
                            <Grid Margin="0,6,0,0">
                                <TabControl x:Name="ResultReverseChildTabControl"
                                            ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                                    <TabItem x:Name="ResultCopyReverseTabItem" Header="Copy reverse">
                                        <ContentControl Content="{Binding CopyReverseTab}" ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem x:Name="ResultDeleteReverseTabItem" Header="Delete reverse">
                                        <ContentControl Content="{Binding DeleteReverseTab}" ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem x:Name="ResultCombinedReverseTabItem" Header="Delete and copy reverse">
                                        <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="RESULT" Style="{StaticResource PanelTitleTextStyle}" />
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBox IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Style="{StaticResource ResultTextBoxStyle}"
                                                             Text="{Binding CombinedDeleteAndCopyReverseScript, Mode=OneWay}" />
                                                </Grid>
                                                <WrapPanel Grid.Row="2"
                                                           Margin="0,6,0,0"
                                                           HorizontalAlignment="Right">
                                                    <Button Content="Copy"
                                                            Width="88"
                                                            Click="CopyCombinedReverseScriptButton_Click" />
                                                    <Button Content="Delete and copy reverse"
                                                            Width="180"
                                                            Margin="8,0,0,0"
                                                            Click="CombinedReverseRunButton_Click" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                    </TabItem>

                    <TabItem x:Name="ReverseTabItem"
                             Header="Reverse">
                <Grid Margin="0,6,0,0">
                    <TabControl x:Name="ReverseChildTabControl"
                                ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem x:Name="ReverseCopyTabItem" Header="COPY REVERSE" DataContext="{Binding CopyReverseTab}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Copy reverse mirror Tab COPY, but uses xcopy in the opposite direction. It is not part of the elevated batch actions." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ReverseDeleteTabItem" Header="DELETE REVERSE" DataContext="{Binding DeleteReverseTab}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Delete reverse mirror Tab COPY, but deletes the mapped output path instead of the input path." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                    </TabItem>
                </TabControl>

                <Border x:Name="SidebarBorder"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="8"
                        MouseEnter="SidebarBorder_MouseEnter"
                        MouseLeave="SidebarBorder_MouseLeave">
                    <Grid>
                        <Grid x:Name="SidebarRootGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Style="{StaticResource PanelBorderStyle}"
                                    Padding="6"
                                    Margin="0,0,0,8">
                                <WrapPanel HorizontalAlignment="Center">
                                <Button x:Name="SidebarPinButton"
                                        Style="{StaticResource SidebarChromeButtonStyle}"
                                        Click="SidebarPinButton_Click"
                                        ToolTip="Pin sidebar" />
                                </WrapPanel>
                            </Border>

                            <ScrollViewer x:Name="SidebarContentHost"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                <ToggleButton Margin="0,6,0,6"
                                              Style="{StaticResource WordWrapToggleStyle}"
                                              IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}" />

                                <Button Margin="0,0,0,6"
                                        Content="Delete selected"
                                        Click="DeleteSelectedLinesButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
                                            <Setter Property="Background" Value="#B33A3A" />
                                            <Setter Property="BorderBrush" Value="#B33A3A" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D04949" />
                                                    <Setter Property="BorderBrush" Value="#D04949" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#9E3030" />
                                                    <Setter Property="BorderBrush" Value="#9E3030" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Margin="0,0,0,6"
                                        Content="Clear all"
                                        Click="ClearAllButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
                                            <Setter Property="Background" Value="#B33A3A" />
                                            <Setter Property="BorderBrush" Value="#B33A3A" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D04949" />
                                                    <Setter Property="BorderBrush" Value="#D04949" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#9E3030" />
                                                    <Setter Property="BorderBrush" Value="#9E3030" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Margin="0,0,0,6"
                                        Content="SAVE"
                                        Click="SaveMarkdownButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
                                            <Setter Property="Background" Value="#2B9369" />
                                            <Setter Property="BorderBrush" Value="#2B9369" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Margin="0,0,0,6"
                                        Content="Open"
                                        Click="LoadMarkdownButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
                                            <Setter Property="Background" Value="#C97728" />
                                            <Setter Property="BorderBrush" Value="#C97728" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="FontSize" Value="11" />
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel>
                                    <TextBlock Text="Search"
                                               Margin="0,0,0,3"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox x:Name="SearchBox"
                                             Style="{StaticResource DarkTextBoxBaseStyle}"
                                             Foreground="{StaticResource TextBrush}"
                                             MinHeight="28"
                                             Height="28"
                                             Padding="8,3"
                                             VerticalContentAlignment="Center"
                                             FontSize="11"
                                             TextChanged="SearchBox_TextChanged" />
                                </StackPanel>
                            </StackPanel>

                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <Thumb x:Name="SidebarEdgeMoveButton"
                               Style="{StaticResource SidebarEdgeHandleStyle}"
                               Visibility="Visible"
                               Panel.ZIndex="5"
                               DragDelta="SidebarEdgeMoveButton_DragDelta"
                               MouseEnter="SidebarEdgeMoveButton_MouseEnter"
                               MouseLeave="SidebarEdgeMoveButton_MouseLeave" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12">
            <WrapPanel>
                <StackPanel
                            Margin="0,0,14,0">
                    <TextBlock Text="Support the project"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="This footer stays readable and anchored even when the window becomes tall and narrow." />
                </StackPanel>

                <Button
                Content="Ủng hộ tác giả Ma Minh Toàn 1993"
                HorizontalAlignment="Right"
                MinWidth="320"
                MinHeight="38"
                Padding="16,7"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#228B22"
                BorderBrush="#1B6F1B"
                Foreground="White"
                Cursor="Hand"
                Click="DonateAuthorButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                    <Setter Property="Background" Value="#228B22" />
                    <Setter Property="BorderBrush" Value="#1B6F1B" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="MinWidth" Value="320" />
                    <Setter Property="MinHeight" Value="38" />
                    <Setter Property="Padding" Value="16,7" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E9E2E" />
                            <Setter Property="BorderBrush" Value="#2E9E2E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#176B17" />
                            <Setter Property="BorderBrush" Value="#176B17" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
