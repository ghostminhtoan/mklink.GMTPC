<Window x:Class="MKLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MKLink.ViewModels"
        mc:Ignorable="d"
        Title="MKLink Path Mapper"
        Height="820"
        Width="1180"
        MinHeight="680"
        MinWidth="980"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <Style x:Key="DarkTextBoxBaseStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="DarkToggleButtonBaseStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#3A3A3A" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WrapTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWordWrapEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditedTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource WrapTextBlockStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                    <Setter Property="Foreground" Value="Cyan" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxBaseStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWordWrapEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxBaseStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="WordWrapToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DarkToggleButtonBaseStyle}">
            <Setter Property="Content" Value="Word Wrap" />
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DarkContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3C3C3C"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4DA3FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="InputPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="INPUT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding SourceItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="{Binding CanEditRows}"
                              IsReadOnly="{Binding IsMirrorTab}"
                              SelectionChanged="InputGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DarkDataGridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Original Input"
                                                Width="2*"
                                                Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}"
                                                EditingElementStyle="{StaticResource WrapTextBoxStyle}" />
                            <DataGridTextColumn Header="Normalized Input"
                                                Width="2*"
                                                IsReadOnly="True"
                                                Binding="{Binding NormalizedInput, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutputPanelTemplate">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Style="{StaticResource OutputTabColumn1Style}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Style="{StaticResource OutputTabRow1Style}" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource OutputPanelOutputBorderStyle}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="OUTPUT"
                                   Style="{StaticResource PanelTitleTextStyle}" />
                        <DataGrid Grid.Row="1"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding SourceItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="InputGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"
                                       BasedOn="{StaticResource DarkDataGridRowStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mapped Target"
                                                    Width="*"
                                                    Binding="{Binding EffectiveOutputPath, Mode=OneWay}"
                                                    ElementStyle="{StaticResource WrapTextBlockStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource OutputPanelEditOutputBorderStyle}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="EDIT OUTPUT"
                                   Style="{StaticResource PanelTitleTextStyle}" />
                        <DataGrid Grid.Row="1"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding SourceItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="InputGrid_SelectionChanged"
                                  Loaded="EditOutputGrid_Loaded">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow"
                                       BasedOn="{StaticResource DarkDataGridRowStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Edit Output"
                                                    Width="*"
                                                    Binding="{Binding EffectiveOutputPath, Mode=OneWay}"
                                                    ElementStyle="{StaticResource EditedTextBlockStyle}" />
                                <DataGridTemplateColumn Header="Filter"
                                                        Width="90">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <Button Content="Filter"
                                                    Padding="4,0"
                                                    MinWidth="70"
                                                    Click="EditOutputFilterHeaderButton_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EditOutputStateText}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions"
                                                        Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Click="EditOutputButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                                            <Setter Property="Width" Value="70" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Restore default"
                                                        Click="RestoreDefaultOutputButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                                            <Setter Property="Width" Value="120" />
                                                            <Setter Property="Margin" Value="6,0,0,0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResultPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Copy"
                                Width="88"
                                Click="CopyResultButton_Click" />
                        <Button Content="Copy, delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="CopyAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="DeleteAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReverseResultPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Click="ReversePrimaryActionButton_Click"
                                Width="140">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseDelete}">
                                            <Setter Property="Content" Value="Delete reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="ReverseSecondaryActionButton_Click"
                                Width="160"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete and copy reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Delete and copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Responsive layout styles -->
        <Style x:Key="MainTabColumn0Style" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="4.2*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="*" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainTabColumn1Style" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="5.8*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainTabRow1Style" TargetType="RowDefinition">
            <Setter Property="Height" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Height" Value="1.4*" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputTabColumn1Style" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="*" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputTabRow1Style" TargetType="RowDefinition">
            <Setter Property="Height" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Height" Value="*" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabInputBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Margin" Value="0,10,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,10,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabInputContentControlStyle" TargetType="ContentControl">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabOutputContentControlStyle" TargetType="ContentControl">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.Row" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputPanelOutputBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutputPanelEditOutputBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPortrait, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Margin" Value="0,5,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Margin="0,0,0,8">
            <ToggleButton Style="{StaticResource WordWrapToggleStyle}"
                          IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}" />
            <Button Content="Delete selected lines"
                    Margin="8,0,0,0"
                    Click="DeleteSelectedLinesButton_Click" />
            <Button Content="Clear all"
                    Margin="6,0,0,0"
                    Click="ClearAllButton_Click" />
            <Separator />
            <Button Content="Save .md"
                    Margin="8,0,0,0"
                    Click="SaveMarkdownButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2E7D32" />
                        <Setter Property="BorderBrush" Value="#2E7D32" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="MinWidth" Value="110" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#388E3C" />
                                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#388E3C" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Load .md"
                    Margin="6,0,0,0"
                    Click="LoadMarkdownButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D84315" />
                        <Setter Property="BorderBrush" Value="#D84315" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="MinHeight" Value="36" />
                        <Setter Property="MinWidth" Value="110" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#E64A19" />
                                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E64A19" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Separator />
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="SearchBox" Width="150" Height="26" VerticalAlignment="Center" Margin="0,0,8,0" TextChanged="SearchBox_TextChanged"/>
        </ToolBar>

        <TabControl Grid.Row="1">
            <TabItem Header="Direct">
                <Grid Margin="0,10,0,0">
                    <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem Header="COPY" DataContext="{Binding CopyTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2.5*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <ToolBar Grid.Row="0">
                                    <Button Content="Browse Root Folder"
                                            IsEnabled="{Binding CanEditRows}"
                                            Click="BrowseRootFolderButton_Click" />
                                    <Separator />
                                    <TextBlock Text="Subfolder Name"
                                               VerticalAlignment="Center"
                                               Margin="8,0,6,0"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Width="180"
                                             IsReadOnly="{Binding IsMirrorTab}"
                                             Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Apply Target"
                                            Margin="8,0,0,0"
                                            Command="{Binding ApplyTargetCommand}" />
                                    <Separator />
                                    <StackPanel Orientation="Vertical"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding RootTargetPath, StringFormat=Target root: {0}}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Each source path will create its own subfolder under this target." />
                                    </StackPanel>
                                </ToolBar>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4.2*" />
                                        <ColumnDefinition Width="5.8*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Margin="0,10,8,0"
                                            Style="{StaticResource PanelBorderStyle}">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="INPUT"
                                                       Style="{StaticResource PanelTitleTextStyle}" />
                                            <DataGrid x:Name="CopyInputGrid"
                                                      Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding SourceItems}"
                                                      AutoGenerateColumns="False"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      AllowDrop="True"
                                                      SelectionChanged="InputGrid_SelectionChanged"
                                                      PreviewMouseLeftButtonDown="CopyInputGrid_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="CopyInputGrid_PreviewMouseMove"
                                                      DragOver="CopyInputGrid_DragOver"
                                                      Drop="CopyInputGrid_Drop"
                                                      PreviewKeyDown="CopyInputGrid_PreviewKeyDown">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow"
                                                           BasedOn="{StaticResource DarkDataGridRowStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Original Input"
                                                                        Width="2*"
                                                                        Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Normalized Input"
                                                                        Width="2*"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding NormalizedInput, Mode=OneWay}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <ContentControl Style="{StaticResource TabOutputContentControlStyle}"
                                                     Content="{Binding}"
                                                     ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>

                                <ContentControl Grid.Row="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ResultPanelTemplate}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="DELETE" DataContext="{Binding DeleteTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="1.8*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="DELETE phu thuoc Tab COPY: chi lay input Copy va khong co output." />
                                </Border>

                                <ContentControl Grid.Row="1"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource InputPanelTemplate}" />

                                <ContentControl Grid.Row="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ResultPanelTemplate}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="MKLINK D" DataContext="{Binding MklinkTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2.5*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="MKLINK D phu thuoc Tab COPY: input va output mirror y chang Copy." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource MainTabColumn0Style}" />
                                        <ColumnDefinition Style="{StaticResource MainTabColumn1Style}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Style="{StaticResource MainTabRow1Style}" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Style="{StaticResource TabInputContentControlStyle}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Style="{StaticResource TabOutputContentControlStyle}"
                                                     Content="{Binding}"
                                                     ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>

                                <ContentControl Grid.Row="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ResultPanelTemplate}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem x:Name="CheckMklinkTab" Header="Check mklink">
            </TabItem>

            <TabItem Header="Reverse">
                <Grid Margin="0,10,0,0">
                    <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem Header="COPY REVERSE" DataContext="{Binding CopyReverseTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2.5*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Copy reverse mirror Tab COPY, but uses xcopy in the opposite direction. It is not part of the elevated batch actions." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource MainTabColumn0Style}" />
                                        <ColumnDefinition Style="{StaticResource MainTabColumn1Style}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Style="{StaticResource MainTabRow1Style}" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Style="{StaticResource TabInputContentControlStyle}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Style="{StaticResource TabOutputContentControlStyle}"
                                                     Content="{Binding}"
                                                     ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>

                                <ContentControl Grid.Row="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="DELETE REVERSE" DataContext="{Binding DeleteReverseTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2.5*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Delete reverse mirror Tab COPY, but deletes the mapped output path instead of the input path." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource MainTabColumn0Style}" />
                                        <ColumnDefinition Style="{StaticResource MainTabColumn1Style}" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Style="{StaticResource MainTabRow1Style}" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Style="{StaticResource TabInputContentControlStyle}"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Style="{StaticResource TabOutputContentControlStyle}"
                                                     Content="{Binding}"
                                                     ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>

                                <ContentControl Grid.Row="2"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Content="Ủng hộ tác giả Ma Minh Toàn 1993"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,10,0,0"
                MinWidth="320"
                MinHeight="44"
                Padding="18,8"
                FontSize="15"
                FontWeight="SemiBold"
                Background="#228B22"
                BorderBrush="#1B6F1B"
                Foreground="White"
                Cursor="Hand"
                Click="DonateAuthorButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                    <Setter Property="Background" Value="#228B22" />
                    <Setter Property="BorderBrush" Value="#1B6F1B" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="MinWidth" Value="320" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="18,8" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E9E2E" />
                            <Setter Property="BorderBrush" Value="#2E9E2E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#176B17" />
                            <Setter Property="BorderBrush" Value="#176B17" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
