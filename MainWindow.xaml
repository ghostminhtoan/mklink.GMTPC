<Window x:Class="MKLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MKLink.ViewModels"
        mc:Ignorable="d"
        Title="MKLink Path Mapper"
        Height="820"
        Width="1180"
        MinHeight="680"
        MinWidth="720"
        FontFamily="Segoe UI"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        DragOver="MainWindow_DragOver"
        Drop="MainWindow_Drop">
    <Window.Resources>
        <Style x:Key="DarkTextBoxBaseStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkToggleButtonBaseStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WrapTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWordWrapEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditedTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource WrapTextBlockStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxBaseStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsWordWrapEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxBaseStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="WordWrapToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DarkToggleButtonBaseStyle}">
            <Setter Property="Content" Value="Word Wrap" />
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DarkContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3C3C3C"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4DA3FF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="InputPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="INPUT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding SourceItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="{Binding CanEditRows}"
                              IsReadOnly="{Binding IsMirrorTab}"
                              SelectionChanged="InputGrid_SelectionChanged"
                              CanUserSortColumns="True"
                              Sorting="InputGrid_Sorting">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DarkDataGridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Input"
                                                Width="*"
                                                Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}"
                                                EditingElementStyle="{StaticResource WrapTextBoxStyle}" />
                            <DataGridTextColumn Header="Normalize Input"
                                                Width="*"
                                                IsReadOnly="True"
                                                Binding="{Binding NormalizedInput, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OutputPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="OUTPUT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <DataGrid Grid.Row="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding SourceItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionChanged="InputGrid_SelectionChanged"
                              Loaded="EditOutputGrid_Loaded"
                              Sorting="OutputGrid_Sorting"
                              PreviewKeyDown="OutputGrid_PreviewKeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"
                                   BasedOn="{StaticResource DarkDataGridRowStyle}">
                                <EventSetter Event="MouseDoubleClick" Handler="OutputGridRow_MouseDoubleClick" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                            <MenuItem Header="Edit Output Path"
                                                      Style="{StaticResource DarkContextMenuItemStyle}"
                                                      Click="RowContextMenuEdit_Click" />
                                            <MenuItem Header="Restore Default Path"
                                                      Style="{StaticResource DarkContextMenuItemStyle}"
                                                      Click="RowContextMenuRestore_Click" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Output"
                                                Width="*"
                                                CanUserSort="False"
                                                Binding="{Binding MappedTarget, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrapTextBlockStyle}" />
                            <DataGridTextColumn Header="Edit Output"
                                                Width="*"
                                                CanUserSort="True"
                                                Binding="{Binding EffectiveOutputPath, Mode=OneWay}"
                                                ElementStyle="{StaticResource EditedTextBlockStyle}" />
                            <DataGridTemplateColumn Header="Filter"
                                                    Width="90"
                                                    CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Button Content="Filter"
                                                Padding="4,0"
                                                MinWidth="70"
                                                Click="EditOutputFilterHeaderButton_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EditOutputStateText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ResultPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                    <WrapPanel Grid.Row="2"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Right">
                        <Button Content="Copy"
                                Width="88"
                                Click="CopyResultButton_Click" />
                        <Button Content="Copy, delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="CopyAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Delete and mklink"
                                Width="140"
                                Margin="8,0,0,0"
                                Click="DeleteAndMklinkButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMirrorTab}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReverseResultPanelTemplate">
            <Border Margin="0,10,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RESULT"
                               Style="{StaticResource PanelTitleTextStyle}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBox IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ResultTextBoxStyle}"
                                 Text="{Binding ScriptResult, Mode=OneWay}" />
                    </Grid>
                                                <WrapPanel Grid.Row="2"
                                                           Margin="0,10,0,0"
                                                           HorizontalAlignment="Right">
                        <Button Click="ReversePrimaryActionButton_Click"
                                Width="140">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseDelete}">
                                            <Setter Property="Content" Value="Delete reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="ReverseSecondaryActionButton_Click"
                                Width="160"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                    <Setter Property="Content" Value="Delete and copy reverse" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScriptMode}" Value="{x:Static vm:ScriptMode.ReverseCopy}">
                                            <Setter Property="Content" Value="Delete and copy reverse" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                                                </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Style="{StaticResource PanelBorderStyle}"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="MKLink Path Mapper"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Rebuilt with a calmer Flet-style shell: clearer cards, lighter hierarchy, and controls that stay usable in both wide and tall window shapes." />
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Top"
                        Padding="12,8"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <TextBlock Text="Responsive layout"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentHoverBrush}" />
                </Border>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,18,0,0"
                           VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource WordWrapToggleStyle}"
                                  IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}" />
                    <Button Content="Delete selected lines"
                            Margin="8,0,0,0"
                            Click="DeleteSelectedLinesButton_Click" />
                    <Button Content="Clear all"
                            Margin="8,0,0,0"
                            Click="ClearAllButton_Click" />
                    <Button Content="Save .md"
                            Margin="8,0,0,0"
                            Click="SaveMarkdownButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                <Setter Property="Background" Value="#2B9369" />
                                <Setter Property="BorderBrush" Value="#2B9369" />
                                <Setter Property="MinWidth" Value="112" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Load .md"
                            Margin="8,0,0,0"
                            Click="LoadMarkdownButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                                <Setter Property="Background" Value="#C97728" />
                                <Setter Property="BorderBrush" Value="#C97728" />
                                <Setter Property="MinWidth" Value="112" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Search"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="SearchBox"
                                 Width="220"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="14">
        <TabControl>
            <TabItem Header="Direct">
                <Grid Margin="0,10,0,0">
                    <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem Header="COPY" DataContext="{Binding CopyTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}"
                                        Padding="12,8">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Browse Root Folder"
                                                IsEnabled="{Binding CanEditRows}"
                                                Click="BrowseRootFolderButton_Click"
                                                Margin="0,4,12,4" />
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                            <TextBlock Text="Subfolder Name"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Width="180"
                                                     VerticalContentAlignment="Center"
                                                     IsReadOnly="{Binding IsMirrorTab}"
                                                     Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="Apply Target"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding ApplyTargetCommand}" />
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Vertical"
                                                    Margin="12,4,0,4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding RootTargetPath, StringFormat=Target root: {0}}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Each source path will create its own subfolder under this target." />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: INPUT panel -->
                                    <Border Grid.Row="0"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource PanelBorderStyle}">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="INPUT"
                                                       Style="{StaticResource PanelTitleTextStyle}" />
                                            <DataGrid x:Name="CopyInputGrid"
                                                      Grid.Row="1"
                                                      Margin="0,8,0,0"
                                                      ItemsSource="{Binding SourceItems}"
                                                      AutoGenerateColumns="False"
                                                      SelectionMode="Extended"
                                                      SelectionUnit="FullRow"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      AllowDrop="True"
                                                      SelectionChanged="InputGrid_SelectionChanged"
                                                      PreviewMouseLeftButtonDown="CopyInputGrid_PreviewMouseLeftButtonDown"
                                                      PreviewMouseMove="CopyInputGrid_PreviewMouseMove"
                                                      DragOver="CopyInputGrid_DragOver"
                                                      Drop="CopyInputGrid_Drop"
                                                      PreviewKeyDown="CopyInputGrid_PreviewKeyDown"
                                                      CanUserSortColumns="True"
                                                      Sorting="InputGrid_Sorting">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow"
                                                           BasedOn="{StaticResource DarkDataGridRowStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowValidationError}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                                                <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Input"
                                                                        Width="*"
                                                                        Binding="{Binding OriginalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        ElementStyle="{StaticResource WrapTextBlockStyle}"
                                                                        EditingElementStyle="{StaticResource WrapTextBoxStyle}" />
                                                    <DataGridTextColumn Header="Normalize Input"
                                                                        Width="*"
                                                                        IsReadOnly="True"
                                                                        Binding="{Binding NormalizedInput, Mode=OneWay}"
                                                                        ElementStyle="{StaticResource WrapTextBlockStyle}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <!-- Row 1: OUTPUT panel -->
                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="DELETE" DataContext="{Binding DeleteTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="DELETE phu thuoc Tab COPY: chi lay input Copy va khong co output." />
                                </Border>

                                <ContentControl Grid.Row="1"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource InputPanelTemplate}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="MKLINK D" DataContext="{Binding MklinkTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="MKLINK D phu thuoc Tab COPY: input va output mirror y chang Copy." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem x:Name="CheckMklinkTab" Header="Check mklink">
            </TabItem>

            <TabItem Header="Result">
                <Grid Margin="0,10,0,0">
                    <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem Header="Direct">
                            <Grid Margin="0,10,0,0">
                                <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                                    <TabItem Header="Result copy direct">
                                        <ContentControl Content="{Binding CopyTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem Header="Result delete direct">
                                        <ContentControl Content="{Binding DeleteTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem Header="Result mklink D direct">
                                        <ContentControl Content="{Binding MklinkTab}" ContentTemplate="{StaticResource ResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem Header="Result copy delete and mklink direct">
                                        <Border Margin="0,10,0,0" Style="{StaticResource PanelBorderStyle}">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="RESULT" Style="{StaticResource PanelTitleTextStyle}" />
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBox IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Style="{StaticResource ResultTextBoxStyle}"
                                                             Text="{Binding CombinedCopyDeleteMklinkScript, Mode=OneWay}" />
                                                </Grid>
                    <WrapPanel Grid.Row="2"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Right">
                                                    <Button Content="Copy"
                                                            Width="88"
                                                            Click="CopyCombinedDirectScriptButton_Click" />
                                                    <Button Content="Copy, delete and mklink"
                                                            Width="140"
                                                            Margin="8,0,0,0"
                                                            Click="CopyAndMklinkButton_Click" />
                                                    <Button Content="Delete and mklink"
                                                            Width="140"
                                                            Margin="8,0,0,0"
                                                            Click="DeleteAndMklinkButton_Click" />
                    </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Reverse">
                            <Grid Margin="0,10,0,0">
                                <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                                    <TabItem Header="Copy reverse">
                                        <ContentControl Content="{Binding CopyReverseTab}" ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem Header="Delete reverse">
                                        <ContentControl Content="{Binding DeleteReverseTab}" ContentTemplate="{StaticResource ReverseResultPanelTemplate}" />
                                    </TabItem>
                                    <TabItem Header="Delete and copy reverse">
                                        <Border Margin="0,10,0,0" Style="{StaticResource PanelBorderStyle}">
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="RESULT" Style="{StaticResource PanelTitleTextStyle}" />
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBox IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             AcceptsTab="True"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollBarVisibility="Auto"
                                                             Style="{StaticResource ResultTextBoxStyle}"
                                                             Text="{Binding CombinedDeleteAndCopyReverseScript, Mode=OneWay}" />
                                                </Grid>
                                                <WrapPanel Grid.Row="2"
                                                           Margin="0,10,0,0"
                                                           HorizontalAlignment="Right">
                                                    <Button Content="Copy"
                                                            Width="88"
                                                            Click="CopyCombinedReverseScriptButton_Click" />
                                                    <Button Content="Delete and copy reverse"
                                                            Width="180"
                                                            Margin="8,0,0,0"
                                                            Click="CombinedReverseRunButton_Click" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Reverse">
                <Grid Margin="0,10,0,0">
                    <TabControl ItemContainerStyle="{StaticResource ChildTabItemStyle}">
                        <TabItem Header="COPY REVERSE" DataContext="{Binding CopyReverseTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Copy reverse mirror Tab COPY, but uses xcopy in the opposite direction. It is not part of the elevated batch actions." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="DELETE REVERSE" DataContext="{Binding DeleteReverseTab}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Style="{StaticResource PanelBorderStyle}">
                                    <TextBlock Margin="12,9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Delete reverse mirror Tab COPY, but deletes the mapped output path instead of the input path." />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ContentControl Grid.Row="0"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource InputPanelTemplate}" />

                                    <ContentControl Grid.Row="1"
                                                    Content="{Binding}"
                                                    ContentTemplate="{StaticResource OutputPanelTemplate}" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="16">
            <WrapPanel>
                <StackPanel
                            Margin="0,0,18,0">
                    <TextBlock Text="Support the project"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="This footer stays readable and anchored even when the window becomes tall and narrow." />
                </StackPanel>

                <Button
                Content="Ủng hộ tác giả Ma Minh Toàn 1993"
                HorizontalAlignment="Right"
                MinWidth="320"
                MinHeight="44"
                Padding="18,8"
                FontSize="15"
                FontWeight="SemiBold"
                Background="#228B22"
                BorderBrush="#1B6F1B"
                Foreground="White"
                Cursor="Hand"
                Click="DonateAuthorButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                    <Setter Property="Background" Value="#228B22" />
                    <Setter Property="BorderBrush" Value="#1B6F1B" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="MinWidth" Value="320" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="18,8" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2E9E2E" />
                            <Setter Property="BorderBrush" Value="#2E9E2E" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#176B17" />
                            <Setter Property="BorderBrush" Value="#176B17" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
