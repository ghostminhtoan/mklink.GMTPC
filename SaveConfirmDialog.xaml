<Window x:Class="MKLink.SaveConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lưu File Markdown"
        Height="210"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="Lưu File Markdown"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,8" />

        <!-- Lời nhắc và đường dẫn file -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Bạn muốn ghi đè lên file cũ hay lưu thành file mới?"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,8" />
            <Border Background="#1C1C1C"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    Padding="10,8">
                <TextBlock x:Name="FilePathText"
                           Text="Đường dẫn file..."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Border>
        </StackPanel>

        <!-- Các nút hành động -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="OverwriteButton"
                    Content="Ghi đè (Overwrite)"
                    Width="140"
                    Height="30"
                    Click="OverwriteButton_Click"
                    Background="#2E7D32"
                    BorderBrush="#2E7D32"
                    Foreground="White"
                    Cursor="Hand"
                    FontWeight="SemiBold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonBaseStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C" />
                                <Setter Property="BorderBrush" Value="#388E3C" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="SaveAsButton"
                    Content="Lưu mới (Save As)..."
                    Width="140"
                    Height="30"
                    Margin="8,0,0,0"
                    Click="SaveAsButton_Click"
                    Cursor="Hand"
                    Style="{StaticResource DarkButtonBaseStyle}" />
            <Button x:Name="CancelButton"
                    Content="Hủy"
                    Width="80"
                    Height="30"
                    Margin="8,0,0,0"
                    Click="CancelButton_Click"
                    Cursor="Hand"
                    Style="{StaticResource DarkButtonBaseStyle}" />
        </StackPanel>
    </Grid>
</Window>
